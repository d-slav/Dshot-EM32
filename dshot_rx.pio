.pio_version 0
.program dshot_rx

.wrap_target
    //////////////////////////
    set x 0	
L_LOOP:
    jmp pin L_END   ;1
    jmp x-- L_NO    ;2
L_NO:
	jmp L_LOOP      ;3
L_END:
    nop
    mov isr, x
    push

    //////////////////////////
    set x 0
H_LOOP:
    jmp pin H_DEC   ;1
    jmp H_END
H_DEC:
    jmp x-- H_NO    ;2
H_NO:
	jmp H_LOOP      ;3
H_END:
    mov isr, x
    push
    //////////////////////////    
.wrap
